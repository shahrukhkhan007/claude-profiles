{
  "name": "claude-profiles",
  "version": "0.1.0",
  "private": true,
  "description": "Run several separate Claude Desktop logins side by side on one machine — one clean app, cross-platform (macOS, Windows, Linux).",
  "author": "Shah Rukh Khan",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
